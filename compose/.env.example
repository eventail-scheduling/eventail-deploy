# The public URLs the web app and the API are reached at, through your proxy:
# scheme and host only, no trailing slash, since both serve from the root and
# WEB_URL is also the CORS origin.
WEB_URL=https://eventail.example.com
API_URL=https://api.eventail.example.com

POSTGRES_PASSWORD=

# Host ports, bound to 127.0.0.1 for the proxy to forward to.
WEB_PORT=8080
API_PORT=3000
