# An empty value still counts as set, so optional settings stay commented out
# until you need them.

# EVENTAIL_BASE_URL and EVENTAIL_AUTH_TOKEN_CACHE_PATH are set by compose.yml,
# because both follow from the topology rather than from your deployment.

EVENTAIL_EDITION_ID=00000000-0000-0000-0000-000000000000

# A machine-to-machine client in your identity provider. Its subject has to
# match the API's JWT_INTEGRATION_PREDICATE.
EVENTAIL_AUTH_ISSUER=https://id.example.com/realms/eventail
EVENTAIL_AUTH_CLIENT_ID=furry-schedule-adapter
EVENTAIL_AUTH_CLIENT_SECRET=replace-with-the-client-secret
# Auth0 needs this to issue a token for the API; Keycloak maps the audience on
# the client instead, so leave it out there. Either way the token's audience
# has to match the API's JWT_AUDIENCE.
#EVENTAIL_AUTH_AUDIENCE=eventail
#EVENTAIL_AUTH_SCOPE=

# Only for a provider on this compose network, which has no TLS to terminate.
# It also drops the HTTPS rule for the request carrying the client secret.
#EVENTAIL_AUTH_ALLOW_INSECURE_ISSUER=true

#EVENTAIL_POLL_INTERVAL=PT15M
#EVENTAIL_LIVE_POLL_INTERVAL=PT1M
#EVENTAIL_REQUEST_TIMEOUT=PT30S

# Eventail stores one language per edition without naming it, so state it.
DOCUMENT_LANGUAGE=en
#DOCUMENT_DESCRIPTION_SOURCE=abstract
#DOCUMENT_MAX_STALENESS=PT12H

# The schema requires a venue that each room names; Eventail holds none.
VENUE_ID=main
VENUE_NAME=Example Convention Center
#VENUE_ADDRESS=

#SOURCE_NAME=eventail
#SOURCE_VENDOR_ID=
