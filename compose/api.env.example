# An empty value still counts as set, so optional settings stay commented out
# until you need them.

JWT_ISSUER=https://id.example.com/realms/eventail
JWT_AUDIENCE=eventail
JWT_SUPER_ADMIN_PREDICATE=sub == 'replace-with-your-subject'
JWT_INTEGRATION_PREDICATE=sub == 'replace-with-your-integration-subject'
USER_INFO_EMAIL_ADDRESS_PATH=email
USER_INFO_DISPLAY_NAME_PATH=name

S3_BUCKET_NAME=eventail
S3_MAX_FILE_SIZE=10mb
S3_PUBLIC_BASE_URL=https://s3.example.com/eventail
S3_CLIENT_ENDPOINT=https://s3.example.com
S3_CLIENT_REGION=us-east-1
S3_CLIENT_FORCE_PATH_STYLE=true
# Without these the AWS default credential chain applies.
#S3_CLIENT_CREDENTIALS_ACCESS_KEY_ID=
#S3_CLIENT_CREDENTIALS_SECRET_ACCESS_KEY=

EMAIL_SENDER=eventail@example.com
EMAIL_SMTP_HOST=smtp.example.com
EMAIL_SMTP_PORT=587
#EMAIL_SMTP_AUTH_USER=
#EMAIL_SMTP_AUTH_PASS=
